# ═════════════════════════════════════════════════
#  FLASK APP
#  Run: python app.py
#  Or:  flask --app app run --debug
# ═════════════════════════════════════════════════
try:
    from flask import Flask, jsonify, send_from_directory, Response
    from flask_cors import CORS

    flask_app = Flask(__name__, static_folder="static", static_url_path="/")
    CORS(flask_app, resources={r"/api/*": {"origins": "*"}})

    # ── Serve index.html at root ─────────────────────────
    @flask_app.route("/")
    def serve_index():
        """Serve the main HTML file."""
        return send_from_directory(flask_app.static_folder, "index.html")

    # ── Author Profile ───────────────────────────────────
    @flask_app.route("/api/profile")
    def api_profile():
        """
        GET /api/profile
        Returns author profile JSON for dynamic rendering.
        """
        return jsonify({"status": "ok", "data": AUTHOR_PROFILE})

    # ── Blog Posts ───────────────────────────────────────
    @flask_app.route("/api/posts")
    def api_posts():
        """
        GET /api/posts
        Returns all blog posts as JSON.
        Query params:
          ?featured=true  — return only featured posts
          ?category=X     — filter by category name
          ?limit=N        — limit result count
        """
        from flask import request
        posts = BLOG_POSTS[:]

        # Optional filters
        featured_only = request.args.get("featured", "").lower() == "true"
        category      = request.args.get("category", "").strip()
        limit         = request.args.get("limit", type=int)

        if featured_only:
            posts = [p for p in posts if p.get("featured")]
        if category:
            posts = [p for p in posts if p["category"].lower() == category.lower()]
        if limit:
            posts = posts[:limit]

        return jsonify({"status": "ok", "count": len(posts), "data": posts})

    # ── Single Post by Slug ──────────────────────────────
    @flask_app.route("/api/posts/<string:slug>")
    def api_post_by_slug(slug: str):
        """
        GET /api/posts/<slug>
        Returns a single blog post by its URL slug.
        """
        post = next((p for p in BLOG_POSTS if p["slug"] == slug), None)
        if post is None:
            return jsonify({"status": "error", "message": "Post not found"}), 404
        return jsonify({"status": "ok", "data": post})

    # ── XML Sitemap ──────────────────────────────────────
    @flask_app.route("/sitemap.xml")
    def sitemap():
        """
        GET /sitemap.xml
        Auto-generates a valid XML sitemap for all known URLs.
        """
        xml = generate_sitemap_xml(BLOG_POSTS, SITE_BASE_URL)
        return Response(xml, mimetype="application/xml")

    # ── Health check ─────────────────────────────────────
    @flask_app.route("/api/health")
    def health():
        return jsonify({"status": "ok", "ts": datetime.datetime.utcnow().isoformat()})

except ImportError:
    flask_app = None
    print("[INFO] Flask not installed — Flask app not initialised.")


# ═════════════════════════════════════════════════
#  FASTAPI APP  (async, production-grade)
#  Run: uvicorn app:fastapi_app --reload
# ═════════════════════════════════════════════════
try:
    from fastapi import FastAPI, HTTPException, Query
    from fastapi.responses import HTMLResponse, Response as FastResponse
    from fastapi.staticfiles import StaticFiles
    from fastapi.middleware.cors import CORSMiddleware
    from typing import Optional

    fastapi_app = FastAPI(
        title="Cyber Automation Engineer API",
        description="Blog and profile API for the Cyber Automation Engineer website.",
        version="1.0.0",
    )

    # CORS
    fastapi_app.add_middleware(
        CORSMiddleware,
        allow_origins=["*"],
        allow_methods=["GET"],
        allow_headers=["*"],
    )

    # Serve static files (optional; remove if hosting elsewhere)
    _static = Path("static")
    if _static.exists():
        fastapi_app.mount("/static", StaticFiles(directory="static"), name="static")

    @fastapi_app.get("/api/profile", tags=["Profile"])
    async def fastapi_profile():
        """Return author profile data."""
        return {"status": "ok", "data": AUTHOR_PROFILE}

    @fastapi_app.get("/api/posts", tags=["Blog"])
    async def fastapi_posts(
        featured: Optional[bool]  = Query(None,  description="Filter featured only"),
        category: Optional[str]   = Query(None,  description="Filter by category"),
        limit:    Optional[int]   = Query(None,  description="Max results to return"),
    ):
        """Return blog posts with optional filters."""
        posts = BLOG_POSTS[:]
        if featured:
            posts = [p for p in posts if p.get("featured")]
        if category:
            posts = [p for p in posts if p["category"].lower() == category.lower()]
        if limit:
            posts = posts[:limit]
        return {"status": "ok", "count": len(posts), "data": posts}

    @fastapi_app.get("/api/posts/{slug}", tags=["Blog"])
    async def fastapi_post(slug: str):
        """Return a single post by slug."""
        post = next((p for p in BLOG_POSTS if p["slug"] == slug), None)
        if not post:
            raise HTTPException(status_code=404, detail="Post not found")
        return {"status": "ok", "data": post}

    @fastapi_app.get("/sitemap.xml", tags=["SEO"])
    async def fastapi_sitemap():
        """Return auto-generated XML sitemap."""
        xml = generate_sitemap_xml(BLOG_POSTS, SITE_BASE_URL)
        return FastResponse(content=xml, media_type="application/xml")

    @fastapi_app.get("/api/health", tags=["System"])
    async def fastapi_health():
        return {"status": "ok", "ts": datetime.datetime.utcnow().isoformat()}

except ImportError:
    fastapi_app = None
    print("[INFO] FastAPI not installed — FastAPI app not initialised.")


# ═════════════════════════════════════════════════
#  SEO UTILITIES
# ═════════════════════════════════════════════════

def generate_sitemap_xml(posts: list, base_url: str) -> str:
    """
    Generate a valid XML sitemap for Google Search Console / Bing.
    Includes static pages and all blog post URLs.

    Usage:
        xml_string = generate_sitemap_xml(BLOG_POSTS, SITE_BASE_URL)
        with open("static/sitemap.xml", "w") as f:
            f.write(xml_string)
    """

    import xml.etree.ElementTree as ET

    today = datetime.date.today().isoformat()

    root = ET.Element("urlset")
    root.set("xmlns", "http://www.sitemaps.org/schemas/sitemap/0.9")
    root.set("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance")
    root.set(
        "xsi:schemaLocation",
        "http://www.sitemaps.org/schemas/sitemap/0.9 "
        "http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd",
    )

    # Static pages
    static_pages = [
        {"loc": base_url + "/",          "priority": "1.0", "changefreq": "weekly"},
        {"loc": base_url + "/#about",    "priority": "0.8", "changefreq": "monthly"},
        {"loc": base_url + "/#blog",     "priority": "0.9", "changefreq": "daily"},
        {"loc": base_url + "/#protocols","priority": "0.7", "changefreq": "monthly"},
        {"loc": base_url + "/#contact",  "priority": "0.6", "changefreq": "yearly"},
    ]

    for page in static_pages:
        url_el = ET.SubElement(root, "url")
        ET.SubElement(url_el, "loc").text        = page["loc"]
        ET.SubElement(url_el, "lastmod").text    = today
        ET.SubElement(url_el, "changefreq").text = page["changefreq"]
        ET.SubElement(url_el, "priority").text   = page["priority"]

    # Blog post pages
    for post in posts:
        url_el = ET.SubElement(root, "url")
        ET.SubElement(url_el, "loc").text        = base_url + "/blog/" + post["slug"]
        ET.SubElement(url_el, "lastmod").text    = post.get("updated_date", today)
        ET.SubElement(url_el, "changefreq").text = "monthly"
        ET.SubElement(url_el, "priority").text   = "0.8" if post.get("featured") else "0.7"

    tree = ET.ElementTree(root)
    ET.indent(tree, space="  ")
    return '<?xml version="1.0" encoding="UTF-8"?>\n' + ET.tostring(root, encoding="unicode")


def inject_seo_meta_tags(template_html: str, meta: dict) -> str:

    Server-side SEO meta-tag injector.
    Replaces placeholder tokens in an HTML template with dynamic values.
    Useful for per-post or per-page meta personalisation.

    Args:
        template_html (str): HTML string with {{TOKEN}} placeholders.
        meta (dict): Dictionary of replacement values.

    Placeholders recognised:
        {{TITLE}}       - <title> and og:title
        {{DESCRIPTION}} - meta description and og:description
        {{KEYWORDS}}    - meta keywords
        {{OG_IMAGE}}    - og:image URL
        {{CANONICAL}}   - canonical link href
        {{AUTHOR}}      - meta author

    Returns:
        str: HTML with all placeholders replaced.

    Example:
        html = open("templates/post.html").read()
