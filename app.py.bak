def generate_robots_txt(base_url: str) -> str:
    """
    Generate a robots.txt file content string.
    Write to static/robots.txt for deployment.
    """
    return f"""User-agent: *
Allow: /

Sitemap: {base_url}/sitemap.xml

# Disallow API endpoints from indexing
Disallow: /api/

# Allow bots access to assets
Allow: /static/
"""


# ═════════════════════════════════════════════════
#  CLI UTILITIES  (run directly)
# ═════════════════════════════════════════════════

def save_sitemap_to_disk():
    """Write sitemap.xml and robots.txt to ./static/"""
    static_dir = Path("static")
    static_dir.mkdir(exist_ok=True)

    sitemap = generate_sitemap_xml(BLOG_POSTS, SITE_BASE_URL)
    (static_dir / "sitemap.xml").write_text(sitemap, encoding="utf-8")
    print(f"[✓] sitemap.xml written to {static_dir / 'sitemap.xml'}")

    robots = generate_robots_txt(SITE_BASE_URL)
    (static_dir / "robots.txt").write_text(robots, encoding="utf-8")
    print(f"[✓] robots.txt written to {static_dir / 'robots.txt'}")


# ═════════════════════════════════════════════════
#  ENTRY POINT
# ═════════════════════════════════════════════════
if __name__ == "__main__":
    import sys

    if "--sitemap" in sys.argv:
        # python app.py --sitemap  → generate static files only
        save_sitemap_to_disk()
    elif "--fastapi" in sys.argv:
        # python app.py --fastapi  → start FastAPI via uvicorn
        try:
            import uvicorn
            uvicorn.run("app:fastapi_app", host="0.0.0.0", port=8000, reload=True)
        except ImportError:
            print("[ERROR] uvicorn not installed. Run: pip install uvicorn[standard]")
    else:
        # Default: Flask dev server
        if flask_app:
            print("Starting Flask development server on http://127.0.0.1:5000")
            print("Place index.html / style.css / script.js in ./static/")
            flask_app.run(debug=True, host="0.0.0.0", port=5000)
        else:
            print("[ERROR] Flask not installed. Run: pip install flask flask-cors")
            print("        Or use --fastapi flag for FastAPI server.")

